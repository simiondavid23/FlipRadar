# FlipRadar — exemplu de configurare .env (copiază în .env și completează)

# ── Optionale (au default-uri — aplicatia porneste si fara .env) ──
# DATABASE_URL — daca lipseste, baza merge automat in directorul de date al
# instantei (in dev = cwd, adica ./flipradar.db). Decomenteaza doar ca sa
# tintesti explicit alt DB.
# DATABASE_URL=sqlite:///./flipradar.db
# alternativ (PostgreSQL): DATABASE_URL=postgresql://postgres:parola@localhost:5432/flipradar
# SECRET_KEY — daca lipseste, se autogenereaza (token_hex(32) = 64 caractere) si
# persista in <data_dir>/secret_key, deci sesiunile supravietuiesc restarturilor.
# Seteaz-o manual doar daca vrei o cheie fixa (min 32 caractere).
# SECRET_KEY=schimba_aceasta_cheie_minim_32_caractere
GROQ_API_KEY=gsk_...
ALGORITHM=HS256

# ── SMTP (opțional) — alerte pe email ─────────────────────────
SMTP_HOST=mail.exemplu.com
SMTP_PORT=587
SMTP_USER=utilizator
SMTP_PASSWORD=parola
SMTP_FROM=no-reply@flipradar.local
SMTP_USE_TLS=true

# ── Proxy (opțional) pentru scrapere ──────────────────────────
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# ── Web Push (VAPID) ──────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=flipradar@exemplu.ro

# ── Criptare cookies grupuri Facebook ─────────────────────────
COOKIE_ENCRYPTION_KEY=

# R5 — FACEBOOK_EMAIL / FACEBOOK_PASSWORD au fost ELIMINATE: login-ul automat headless
# atrăgea checkpoint pe cont (și ținea parola în clar aici). Sesiunea Facebook se face
# MANUAL din Setări Radar → Facebook; când expiră, aplicația doar semnalează.

# ── Logs persistente în DB (MODIFICARE 12, opțional) ──────────
LOG_DB_PERSISTENCE=false

# ── Rotatie IP prin modem USB Huawei HiLink (optional) ────────
# Metoda depinde de OPERATOR, masurat empiric pe acelasi modem:
#   Digi   - dataswitch functioneaza (~34s), fara repornire fizica
#   Orange - dataswitch NU schimba IP-ul, e nevoie de reboot (~45s)
# Daca dataswitch nu mai schimba WanIPAddress de MODEM_ESCALATE_AFTER ori
# la rand, urmatoarea rotatie foloseste automat reboot.
MODEM_ROTATION_ENABLED=false
MODEM_ROTATION_METHOD=dataswitch
MODEM_HOST=192.168.8.1
MODEM_USERNAME=admin
MODEM_PASSWORD=
MODEM_BIND_IP=
MODEM_PDP_DOWN_S=30
MODEM_ESCALATE_AFTER=2
MODEM_ROTATION_COOLDOWN_S=600
MODEM_ROTATION_MAX_PER_HOUR=5

# Platformele al caror trafic iese prin modem. Lista de PERMISIUNI: ce nu e aici
# merge pe conexiunea principala. Gol = nimic legat (kill-switch, comportament
# identic cu cel de dinainte de NET-5).
# NU pune aici platforme cu sesiune autentificata (olx logat, facebook): un cookie
# care apare de pe IP-uri diferite arata ca o sesiune furata si duce la checkpoint.
# RC-1: `autovit` si `mobilede` au iesit din Radar Piata (masinile raman doar in
# modulul Auto), iar scraperele Auto NU trec prin binding — deci n-au ce cauta aici.
MODEM_ROUTED_PLATFORMS=vinted,okazii,publi24,lajumate

# ASN-ul retelei modemului, din scripts/diagnostics/bind_two_paths_probe.py.
# Fara el, garda anti-scurgere din rotator se auto-calibreaza din PRIMA masuratoare
# reusita - si daca aceea a scurs pe alta interfata, ramane calibrata gresit.
# Se accepta si "AS8708", si sirul intreg "AS8708 RCS & RDS": comparatia se face pe
# numar, nu pe descrierea operatorului (text liber de la ip-api).
MODEM_EXPECTED_ASN=AS8708

# NET-5.3 — un raspuns clasificat BLOCKED (403 / 401 / captcha / interstitial) pe o
# platforma din lista de mai sus DECLANSEAZA o rotatie de IP, iar daca WanIPAddress chiar
# s-a schimbat, requestul se reia imediat pe IP-ul nou. Declansarea se auto-limiteaza prin
# MODEM_ROTATION_COOLDOWN_S si MODEM_ROTATION_MAX_PER_HOUR de mai sus - restul blocajelor
# cad pe backoff normal. Rate-limit-ul (429) NU roteste: e o fereastra de timp, nu o
# problema de reputatie a IP-ului.
# Plafonul zilnic Vinted per IP se reseteaza dupa o rotatie reusita (un IP nou primeste
# buget nou de la DataDome), DAR exista si un plafon global zilnic pe care rotatia nu-l
# atinge - ca rotatia sa nu devina o cale de ocolire a propriei discipline de cadenta.

# ATENTIE la topologie: modemul NU trebuie sa detina ruta default, altfel binding-ul
# selectiv nu are efect util - tot traficul iese oricum prin modem, inclusiv al
# platformelor excluse intentionat, iar o rotatie taie toata iesirea procesului.
# Pe Windows: Get-NetIPInterface -AddressFamily IPv4  (metrica interfetei RNDIS trebuie
# sa fie MAI MARE decat a WiFi-ului). Aplicatia avertizeaza, dar nu poate corecta singura.
